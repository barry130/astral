<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.astral</groupId>
        <artifactId>astral</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>astral-auth</artifactId>
    <packaging>jar</packaging>
    <name>astral-auth</name>
    <description>Authentication module</description>

    <dependencies>
        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-common</artifactId>
        </dependency>

        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-dao</artifactId>
        </dependency>

        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-log</artifactId>
        </dependency>

        <!-- 插件权限声明 SPI（PermissionProvider）：启动时把插件声明的权限登记进 sys_permission。
             astral-plugin-api 无任何依赖，不会引入环。 -->
        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-plugin-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- @RequiresPermission / @RequiresSuper 的切面实现（@Aspect）。
             astral-log 已传递引入，这里显式声明，避免依赖别人的传递依赖。
             SB4 起 starter 名为 spring-boot-starter-aspectj。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
            <version>1.46.0</version>
        </dependency>

        <!-- 登录失败限流的 Redis 计数（LoginFailureStore）：与 Sa-Token 会话共用同一 Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-crypto</artifactId>
        </dependency>
    </dependencies>
</project>