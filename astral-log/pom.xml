<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.astral</groupId>
        <artifactId>astral</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>astral-log</artifactId>
    <packaging>jar</packaging>
    <name>astral-log</name>
    <description>Log service module</description>

    <dependencies>
        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-common</artifactId>
        </dependency>

        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-dao</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 控制器 @RequestBody 上的 @Valid 触发字段级 @Size 校验（500→400） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot 4 起 spring-boot-starter-aop 更名为 spring-boot-starter-aspectj -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- 仅使用 cn.hutool.core.util.StrUtil，用 hutool-core 即可 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
        </dependency>

        <!-- CVE-2026-91776（TypeDeserializerBase._findDeserializer 的类型 ID 缓存无上限，
             name-based 多态 + defaultImpl 回退时每个未知类型 ID 都会留下一份缓存）。
             本模块代码不引用 com.fasterxml.jackson.databind，它此前是 springdoc / MyBatis-Plus
             等带进来的传递依赖（2.21.4）；统一由根 pom 的 Jackson 2 BOM 抬到 2.22.3。
             这里显式声明，是为了让本模块的依赖树里出现并钉住修复版本，
             同时不依赖「谁恰好把 databind 传进来」这种偶然性。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
    </dependencies>
</project>