package com.astral.qt.config;

import cn.dev33.satoken.stp.StpUtil;
import com.astral.qt.common.QtRestResp;
import com.fasterxml.jackson.databind.ObjectMapper;
import jakarta.annotation.Resource;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;
import org.springframework.web.servlet.HandlerInterceptor;

import java.util.Set;

/**
 * 轻听 API 认证拦截器
 * <p>解析 {@code satoken} 请求头，通过宿主 Sa-Token 校验登录态；
 * 未携带 / 无效 / 过期时返回 {@code 401}（前端据此清除登录态）。
 * 认证通过后把 userId 写入 request attribute 供控制器使用。</p>
 * <p>轻听用户已并入宿主 sys_user，鉴权与管理系统统一走 Sa-Token。</p>
 */
@Slf4j
@Component
public class QtAuthInterceptor implements HandlerInterceptor {

    /** 免认证的用户端路径（白名单） */
    private static final Set<String> PUBLIC_PATHS = Set.of(
            "/api/v1/user/login",
            "/api/v1/user/register",
            "/api/v1/user/email",
            "/api/v1/user/changePass",
            "/api/v1/user/upload"
    );

    @Resource
    private ObjectMapper objectMapper;

    @Override
    public boolean preHandle(HttpServletRequest request, HttpServletResponse response, Object handler) throws Exception {
        String uri = request.getRequestURI();

        // 仅拦截用户区；App 公共区（/api/v1/app/**）在控制器层直接放行
        if (!uri.startsWith("/api/v1/user/") || PUBLIC_PATHS.contains(uri)) {
            return true;
        }

        // 由 SaTokenContextFilter 从 satoken 请求头解析登录态。
        // getLoginIdByToken 返回的 loginId 可能是 String 也可能是 Number，
        // 统一按字符串解析为 Long 以兼容宿主/插件两种登录态。
        Long userId = null;
        try {
            Object loginId = StpUtil.getLoginIdByToken(request.getHeader("satoken"));
            if (loginId != null) {
                userId = Long.parseLong(loginId.toString());
            }
        } catch (Exception e) {
            userId = null;
        }

        if (userId == null) {
            response.setContentType("application/json;charset=UTF-8");
            response.getWriter().write(objectMapper.writeValueAsString(
                    QtRestResp.error(401, "登录状态已失效")
            ));
            return false;
        }

        request.setAttribute("userId", userId);
        return true;
    }
}
