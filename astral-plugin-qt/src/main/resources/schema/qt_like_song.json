{
  "tableName": "qt_like_song",
  "tableComment": "轻听App收藏歌曲表",
  "moduleName": "qt",
  "className": "QtLikeSong",
  "fields": [
    {
      "columnName": "id",
      "fieldName": "id",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "主键ID",
      "isPrimaryKey": true,
      "isAutoIncrement": true,
      "mybatisPlusIdType": "INPUT"
    },
    {
      "columnName": "uid",
      "fieldName": "uid",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "用户ID",
      "isRequired": true
    },
    {
      "columnName": "sid",
      "fieldName": "sid",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "歌曲ID",
      "length": 64,
      "isRequired": true
    },
    {
      "columnName": "pid",
      "fieldName": "pid",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "歌曲所属歌单ID(空串=不归属具体歌单,同一歌曲可收藏到多个歌单)",
      "length": 64,
      "isRequired": true,
      "defaultValue": "''"
    },
    {
      "columnName": "platform",
      "fieldName": "platform",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "平台(1-网易云 2-QQ音乐 3-酷狗 4-酷我 5-其他)",
      "length": 16,
      "isRequired": true
    },
    {
      "columnName": "name",
      "fieldName": "name",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "歌曲名",
      "length": 128
    },
    {
      "columnName": "singer",
      "fieldName": "singer",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "歌手",
      "length": 128
    },
    {
      "columnName": "album",
      "fieldName": "album",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "专辑",
      "length": 128
    },
    {
      "columnName": "hash",
      "fieldName": "hash",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "歌曲Hash",
      "length": 128
    },
    {
      "columnName": "pic_url",
      "fieldName": "picUrl",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "歌曲封面图片地址(URL快照,可空)",
      "length": 2048
    },
    {
      "columnName": "deleted_at",
      "fieldName": "deletedAt",
      "fieldType": "LocalDateTime",
      "jdbcType": "TIMESTAMP",
      "comment": "删除时间"
    },
    {
      "columnName": "updated_seq",
      "fieldName": "updatedSeq",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "用户收藏变更序号(多端同步游标,用户维度递增)"
    },
    {
      "columnName": "updated_at",
      "fieldName": "updatedAt",
      "fieldType": "LocalDateTime",
      "jdbcType": "TIMESTAMP",
      "comment": "收藏状态变更时间"
    },
    {
      "columnName": "create_time",
      "fieldName": "createTime",
      "fieldType": "LocalDateTime",
      "jdbcType": "TIMESTAMP",
      "comment": "创建时间",
      "isAutoFill": "INSERT"
    },
    {
      "columnName": "update_time",
      "fieldName": "updateTime",
      "fieldType": "LocalDateTime",
      "jdbcType": "TIMESTAMP",
      "comment": "更新时间",
      "isAutoFill": "INSERT_UPDATE"
    }
  ],
  "indexes": [
    {
      "indexName": "idx_qt_like_song",
      "columns": [
        "uid",
        "sid",
        "platform",
        "deleted_at"
      ]
    },
    {
      "indexName": "idx_like_song_uid_seq",
      "columns": [
        "uid",
        "updated_seq"
      ]
    },
    {
      "indexName": "uk_like_song_key_pid",
      "columns": [
        "uid",
        "sid",
        "platform",
        "pid"
      ],
      "isUnique": true
    }
  ]
}
