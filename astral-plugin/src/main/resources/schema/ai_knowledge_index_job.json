                       "defaultValue":  "FULL"
                   },
                   {
                       "columnName":  "status",
                       "fieldName":  "status",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(32)",
                       "comment":  "任务状态",
                       "length":  32,
                       "defaultValue":  "QUEUED"
                   },
