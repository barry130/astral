                       "fieldName":  "enabled",
                       "fieldType":  "Boolean",
                       "jdbcType":  "BOOLEAN",
                       "comment":  "是否启用",
                       "defaultValue":  "true"
                   },
                   {
                       "columnName":  "sync_mode",
                       "fieldName":  "syncMode",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(16)",
                       "comment":  "同步方式",
                       "length":  16,
                       "defaultValue":  "MANUAL"
                   },
                   {
                       "columnName":  "status",
                       "fieldName":  "status",
