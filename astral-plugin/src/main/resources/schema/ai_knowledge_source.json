                       "defaultValue":  "0"
                   },
                   {
                       "columnName":  "created_by",
                       "fieldName":  "createdBy",
                       "fieldType":  "Long",
                       "jdbcType":  "BIGINT",
                       "comment":  "创建人"
                   },
                   {
                       "columnName":  "updated_by",
                       "fieldName":  "updatedBy",
                       "fieldType":  "Long",
                       "jdbcType":  "BIGINT",
                       "comment":  "更新人"
                   },
                   {
                       "columnName":  "create_time",
                       "fieldName":  "createTime",
                       "fieldType":  "LocalDateTime",
                       "jdbcType":  "TIMESTAMP",
                       "comment":  "创建时间",
                       "isAutoFill":  "INSERT"
                   },
                   {
                       "columnName":  "update_time",
                       "fieldName":  "updateTime",
                       "fieldType":  "LocalDateTime",
                       "jdbcType":  "TIMESTAMP",
                       "comment":  "更新时间",
                       "isAutoFill":  "INSERT_UPDATE"
                   }
