                       "comment":  "知识源名称",
                       "length":  128,
                       "isRequired":  true
                   },
                   {
                       "columnName":  "source_type",
                       "fieldName":  "sourceType",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(48)",
                       "comment":  "知识源类型",
                       "length":  48,
                       "isRequired":  true
                   },
                   {
                       "columnName":  "description",
                       "fieldName":  "description",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(512)",
                       "comment":  "描述",
                       "length":  512
                   },
                   {
                       "columnName":  "path_pattern",
                       "fieldName":  "pathPattern",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(512)",
                       "comment":  "路径匹配",
                       "length":  512
                   },
