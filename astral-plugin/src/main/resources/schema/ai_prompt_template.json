{
    "tableName":  "ai_prompt_template",
    "tableComment":  "AI 提示词模板",
    "moduleName":  "ai",
    "className":  "AiPromptTemplateEntity",
    "fields":  [
                   {
                       "columnName":  "id",
                       "fieldName":  "id",
                       "fieldType":  "Long",
                       "jdbcType":  "BIGINT",
                       "comment":  "主键",
                       "isPrimaryKey":  true,
                       "isAutoIncrement":  false,
                       "mybatisPlusIdType":  "INPUT"
                   },
                   {
                       "columnName":  "prompt_code",
                       "fieldName":  "promptCode",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(64)",
                       "comment":  "模板编码",
                       "length":  64,
                       "isRequired":  true
                   },
                   {
                       "columnName":  "name",
                       "fieldName":  "name",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(128)",
                       "comment":  "模板名称",
                       "length":  128,
                       "isRequired":  true
                   },
                   {
                       "columnName":  "scene",
                       "fieldName":  "scene",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(64)",
                       "comment":  "使用场景",
                       "length":  64
                   },
                   {
                       "columnName":  "description",
                       "fieldName":  "description",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(512)",
                       "comment":  "描述",
                       "length":  512
                   },
                   {
                       "columnName":  "status",
                       "fieldName":  "status",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(32)",
                       "comment":  "状态",
                       "length":  32,
                       "isRequired":  true,
                       "defaultValue":  "DRAFT"
                   },
                   {
                       "columnName":  "created_by",
                       "fieldName":  "createdBy",
                       "fieldType":  "Long",
                       "jdbcType":  "BIGINT",
                       "comment":  "创建人"
                   },
                   {
                       "columnName":  "updated_by",
                       "fieldName":  "updatedBy",
                       "fieldType":  "Long",
                       "jdbcType":  "BIGINT",
                       "comment":  "更新人"
                   },
                   {
                       "columnName":  "create_time",
                       "fieldName":  "createTime",
                       "fieldType":  "LocalDateTime",
                       "jdbcType":  "TIMESTAMP",
                       "comment":  "创建时间",
                       "isAutoFill":  "INSERT"
                   },
                   {
                       "columnName":  "update_time",
                       "fieldName":  "updateTime",
                       "fieldType":  "LocalDateTime",
                       "jdbcType":  "TIMESTAMP",
                       "comment":  "更新时间",
                       "isAutoFill":  "INSERT_UPDATE"
                   }
               ],
    "indexes":  [
                    {
                        "indexName":  "uk_ai_prompt_template_code",
                        "columns":  [
                                        "prompt_code"
                                    ],
                        "isUnique":  true
                    }
                ]
}