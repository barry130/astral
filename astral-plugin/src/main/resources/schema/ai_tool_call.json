{
    "tableName":  "ai_tool_call",
    "tableComment":  "AI 工具调用",
    "moduleName":  "ai",
    "className":  "AiToolCallEntity",
    "fields":  [
                   {"columnName":"reconciled_by","fieldName":"reconciledBy","fieldType":"Long","jdbcType":"BIGINT","comment":"人工核对人"},
                   {"columnName":"reconciled_at","fieldName":"reconciledAt","fieldType":"LocalDateTime","jdbcType":"TIMESTAMP","comment":"人工核对时间"},
                   {"columnName":"reconciliation_note","fieldName":"reconciliationNote","fieldType":"String","jdbcType":"VARCHAR(1000)","comment":"人工核对依据"},
                   {"columnName":"execution_token","fieldName":"executionToken","fieldType":"String","jdbcType":"VARCHAR(64)","comment":"工具执行认领标识，未知结果不自动重放"},
                   {"columnName":"provider_tool_call_id","fieldName":"providerToolCallId","fieldType":"String","jdbcType":"VARCHAR(255)","comment":"模型返回的工具调用标识"},
                   {"columnName":"assistant_message_id","fieldName":"assistantMessageId","fieldType":"Long","jdbcType":"BIGINT","comment":"所属工具轮助手消息"},
                   {"columnName":"tool_message_id","fieldName":"toolMessageId","fieldType":"Long","jdbcType":"BIGINT","comment":"一一对应的工具结果消息"},
                   {
                       "columnName":  "id",
                       "fieldName":  "id",
                       "fieldType":  "Long",
                       "jdbcType":  "BIGINT",
                       "comment":  "主键",
                       "isPrimaryKey":  true,
                       "isAutoIncrement":  false,
                       "mybatisPlusIdType":  "INPUT"
                   },
                   {
                       "columnName":  "request_id",
                       "fieldName":  "requestId",
                       "fieldType":  "Long",
                       "jdbcType":  "BIGINT",
                       "comment":  "请求 ID（后台试跑不归属任何请求，为空）"
                   },
                   {
                       "columnName":  "tool_code",
                       "fieldName":  "toolCode",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(64)",
                       "comment":  "工具编码",
                       "length":  64,
                       "isRequired":  true
                   },
                   {
                       "columnName":  "tool_name",
                       "fieldName":  "toolName",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(128)",
                       "comment":  "工具名称",
                       "length":  128
                   },
                   {
                       "columnName":  "risk_level",
                       "fieldName":  "riskLevel",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(16)",
                       "comment":  "风险等级",
                       "length":  16
                   },
                   {
                       "columnName":  "status",
                       "fieldName":  "status",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(16)",
                       "comment":  "状态",
                       "length":  16,
                       "isRequired":  true,
                       "defaultValue":  "PLANNED"
                   },
                   {
                       "columnName":  "arguments_json",
                       "fieldName":  "argumentsJson",
                       "fieldType":  "String",
                       "jdbcType":  "TEXT",
                       "comment":  "参数"
                   },
                   {
                       "columnName":  "result_json",
                       "fieldName":  "resultJson",
                       "fieldType":  "String",
                       "jdbcType":  "TEXT",
                       "comment":  "结果"
                   },
                   {
                       "columnName":  "error_message",
                       "fieldName":  "errorMessage",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(1024)",
                       "comment":  "错误信息",
                       "length":  1024
                   },
                   {
                       "columnName":  "approval_status",
                       "fieldName":  "approvalStatus",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(24)",
                       "comment":  "确认状态",
                       "length":  24,
                       "defaultValue":  "NONE"
                   },
                   {
                       "columnName":  "approved_by",
                       "fieldName":  "approvedBy",
                       "fieldType":  "Long",
                       "jdbcType":  "BIGINT",
                       "comment":  "确认人"
                   },
                   {
                       "columnName":  "approved_at",
                       "fieldName":  "approvedAt",
                       "fieldType":  "LocalDateTime",
                       "jdbcType":  "TIMESTAMP",
                       "comment":  "确认时间"
                   },
                   {
                       "columnName":  "started_at",
                       "fieldName":  "startedAt",
                       "fieldType":  "LocalDateTime",
                       "jdbcType":  "TIMESTAMP",
                       "comment":  "开始时间"
                   },
                   {
                       "columnName":  "finished_at",
                       "fieldName":  "finishedAt",
                       "fieldType":  "LocalDateTime",
                       "jdbcType":  "TIMESTAMP",
                       "comment":  "结束时间"
                   },
                   {
                       "columnName":  "create_time",
                       "fieldName":  "createTime",
                       "fieldType":  "LocalDateTime",
                       "jdbcType":  "TIMESTAMP",
                       "comment":  "创建时间",
                       "isAutoFill":  "INSERT"
                   },
                   {
                       "columnName":  "update_time",
                       "fieldName":  "updateTime",
                       "fieldType":  "LocalDateTime",
                       "jdbcType":  "TIMESTAMP",
                       "comment":  "更新时间",
                       "isAutoFill":  "INSERT_UPDATE"
                   },
                   {
                       "columnName":  "source",
                       "fieldName":  "source",
                       "fieldType":  "String",
                       "jdbcType":  "VARCHAR(16)",
                       "comment":  "来源（chat=会话调用，test-run=后台试跑）",
                       "length":  16,
                       "defaultValue":  "chat",
                       "isRequired":  true

},

{

"columnName":  "plan_hash",

"fieldName":  "planHash",

"fieldType":  "String",

"jdbcType":  "VARCHAR(64)",

"comment":  "计划期配置快照哈希（executor_config|risk|approval 的 SHA-256，审批时比对防 TOCTOU）",

"length":  64,

"defaultValue":  "",

"isRequired":  true

}

],
    "indexes":  [
                    {
                        "indexName":  "idx_ai_tool_call_request",
                        "columns":  [
                                        "request_id"
                                    ]
                    }
                ]
}
