{
  "tableName": "sys_notice",
  "tableComment": "统一通知表(qt_app_notice超集)",
  "moduleName": "feedback",
  "className": "SysNotice",
  "fields": [
    {
      "columnName": "id",
      "fieldName": "id",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "主键ID",
      "isPrimaryKey": true,
      "isAutoIncrement": false,
      "mybatisPlusIdType": "INPUT"
    },
    {
      "columnName": "channel",
      "fieldName": "channel",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "渠道(app/web/all)",
      "isRequired": true,
      "defaultValue": "app",
      "length": 16
    },
    {
      "columnName": "notice_type",
      "fieldName": "noticeType",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "类型(announce公告/feedback反馈/request需求)",
      "isRequired": true,
      "defaultValue": "announce",
      "length": 16
    },
    {
      "columnName": "user_id",
      "fieldName": "userId",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "点对点目标用户ID(NULL=广播)"
    },
    {
      "columnName": "feedback_id",
      "fieldName": "feedbackId",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "关联反馈ID(sys_feedback.id)"
    },
    {
      "columnName": "display",
      "fieldName": "display",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "展示位掩码(1开屏/2通告栏/4消息中心,可叠加)",
      "isRequired": true,
      "defaultValue": "4"
    },
    {
      "columnName": "title",
      "fieldName": "title",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "标题",
      "isRequired": true,
      "length": 128
    },
    {
      "columnName": "content",
      "fieldName": "content",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "内容",
      "length": 65535
    },
    {
      "columnName": "url",
      "fieldName": "url",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "点击跳转链接",
      "length": 512
    },
    {
      "columnName": "is_show",
      "fieldName": "isShow",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "是否启用(0隐藏 1展示)",
      "isRequired": true,
      "defaultValue": "1"
    },
    {
      "columnName": "is_top",
      "fieldName": "isTop",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "是否置顶(0否 1是)",
      "isRequired": true,
      "defaultValue": "0"
    },
    {
      "columnName": "dialog_closable",
      "fieldName": "dialogClosable",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "开屏弹窗是否可关闭",
      "isRequired": true,
      "defaultValue": "1"
    },
    {
      "columnName": "first_login_only",
      "fieldName": "firstLoginOnly",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "仅首次登录弹出",
      "isRequired": true,
      "defaultValue": "0"
    },
    {
      "columnName": "marquee",
      "fieldName": "marquee",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "通告栏是否跑马灯",
      "isRequired": true,
      "defaultValue": "0"
    },
    {
      "columnName": "effective_start",
      "fieldName": "effectiveStart",
      "fieldType": "LocalDateTime",
      "jdbcType": "TIMESTAMP",
      "comment": "生效时间(空不限)"
    },
    {
      "columnName": "effective_end",
      "fieldName": "effectiveEnd",
      "fieldType": "LocalDateTime",
      "jdbcType": "TIMESTAMP",
      "comment": "失效时间(空不限)"
    },
    {
      "columnName": "version_min",
      "fieldName": "versionMin",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "生效版本码下限(如300)"
    },
    {
      "columnName": "version_max",
      "fieldName": "versionMax",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "生效版本码上限"
    },
    {
      "columnName": "audience",
      "fieldName": "audience",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "可见人群(ALL/LOGGED_IN/NOT_LOGGED_IN)",
      "isRequired": true,
      "defaultValue": "ALL",
      "length": 16
    },
    {
      "columnName": "create_time",
      "fieldName": "createTime",
      "fieldType": "LocalDateTime",
      "jdbcType": "TIMESTAMP",
      "comment": "创建时间",
      "isAutoFill": "INSERT"
    },
    {
      "columnName": "update_time",
      "fieldName": "updateTime",
      "fieldType": "LocalDateTime",
      "jdbcType": "TIMESTAMP",
      "comment": "更新时间",
      "isAutoFill": "INSERT_UPDATE"
    }
  ],
  "indexes": [
    {
      "indexName": "idx_notice_channel",
      "columns": [
        "channel"
      ]
    },
    {
      "indexName": "idx_notice_type",
      "columns": [
        "notice_type"
      ]
    },
    {
      "indexName": "idx_notice_user",
      "columns": [
        "user_id"
      ]
    },
    {
      "indexName": "idx_notice_show",
      "columns": [
        "is_show",
        "is_top"
      ]
    },
    {
      "indexName": "idx_notice_create_time",
      "columns": [
        "create_time"
      ]
    }
  ]
}
