      "isAutoIncrement": true,
      "mybatisPlusIdType": "INPUT"
    },
    {
      "columnName": "parent_id",
      "fieldName": "parentId",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "父菜单ID",
      "defaultValue": "0"
