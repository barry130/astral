{
  "tableName": "sys_notify_rule",
  "tableComment": "事件订阅规则（事件级策略卡：一个事件可有多条规则，渠道明细见 sys_notify_rule_channel）",
  "moduleName": "system",
  "className": "SysNotifyRule",
  "fields": [
    {
      "columnName": "id",
      "fieldName": "id",
      "fieldType": "Long",
      "jdbcType": "BIGINT",
      "comment": "主键ID",
      "isPrimaryKey": true,
      "isAutoIncrement": true,
      "mybatisPlusIdType": "INPUT"
    },
    {
      "columnName": "rule_name",
      "fieldName": "ruleName",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "规则名称",
      "length": 64
    },
    {
      "columnName": "event_code",
      "fieldName": "eventCode",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "事件码",
      "length": 64
    },
    {
      "columnName": "sender",
      "fieldName": "sender",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "触发方类型(system/qt/ai/feedback，仅审计用)",
      "length": 32
    },
    {
      "columnName": "enabled",
      "fieldName": "enabled",
      "fieldType": "Integer",
      "jdbcType": "SMALLINT",
      "comment": "是否启用(1是0否)"
    },
    {
      "columnName": "remark",
      "fieldName": "remark",
      "fieldType": "String",
      "jdbcType": "VARCHAR",
      "comment": "备注",
      "length": 256
    },
    {
      "columnName": "create_time",
      "fieldName": "createTime",
      "fieldType": "LocalDateTime",
      "jdbcType": "TIMESTAMP",
      "comment": "创建时间",
      "isAutoFill": "INSERT"
    },
    {
      "columnName": "update_time",
      "fieldName": "updateTime",
      "fieldType": "LocalDateTime",
      "jdbcType": "TIMESTAMP",
      "comment": "更新时间",
      "isAutoFill": "UPDATE"
    }
  ],
  "indexes": [
    {
      "indexName": "uk_sys_notify_rule_name",
      "columns": ["rule_name"],
      "isUnique": true
    },
    {
      "indexName": "idx_sys_notify_rule_event",
      "columns": ["event_code", "enabled"]
    }
  ]
}
