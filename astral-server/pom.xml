<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.astral</groupId>
        <artifactId>astral</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>astral-server</artifactId>
    <packaging>jar</packaging>
    <name>astral-server</name>
    <description>Web server module</description>
    <dependencies>
        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-schema</artifactId>
        </dependency>
        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-dao</artifactId>
        </dependency>
        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-monitor</artifactId>
        </dependency>
        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-sequence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-plugin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <!-- Flyway 数据库迁移：启动时自动按序应用 db/migration/V*.sql 并记录 flyway_schema_history。
             【Spring Boot 4 关键变化】Flyway 自动配置已从 spring-boot-autoconfigure 拆到独立模块
             spring-boot-flyway（该模块内含 flyway-core 12.x）。若只依赖 flyway-core，
             FlywayAutoConfiguration 不会存在于 classpath，Flyway 将【静默不执行】、迁移失效。
             Flyway 10 起数据库支持同样拆分为独立模块，PostgreSQL 需再引 flyway-database-postgresql。
             存量库通过 baseline-on-migrate 跳过 V1 基线（见 application.yml spring.flyway）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
            <version>1.46.0</version>
        </dependency>
        <!-- MyBatis-Plus 分页拦截器 PaginationInnerInterceptor（见 MybatisPlusConfig）。
             3.5.9 起该类从 mybatis-plus-extension 移到 mybatis-plus-jsqlparser，
             且 starter 聚合 pom 中标记 optional 不传递，必须显式引入，否则分页 SQL 改写失效。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 限流窗口容器：需要带过期淘汰与容量上限，否则按 IP 的 key 会把堆撑爆 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.astral.server.AstralApplication</mainClass>
                    <!-- Lombok 仅在编译期做注解处理，绝不能进运行 jar（约 1.96MB）。
                         provided 作用域不足以让它出局，必须显式排除。 -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>