<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.astral</groupId>
        <artifactId>astral</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>astral-system</artifactId>
    <packaging>jar</packaging>
    <name>astral-system</name>
    <description>System management module</description>

    <dependencies>
        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-common</artifactId>
        </dependency>

        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-dao</artifactId>
        </dependency>

        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-auth</artifactId>
        </dependency>

        <dependency>
            <groupId>com.astral</groupId>
            <artifactId>astral-schema</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 控制器 @RequestBody 上的 @Valid 触发字段级 @Size 校验（500→400） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- 每日发信额度需要原子自增计数（INCR + EXPIRE），用 Redis 原语替代
             "先 COUNT 再发送" 的非原子写法；required=false 注入，Redis 不可用时降级为 DB 计数 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- UserController / UserServiceImpl 使用 BCrypt，显式声明避免依赖传递巧合 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
    </dependencies>
</project>
