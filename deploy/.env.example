# ============================================
# Astral 部署环境变量模板
# 复制本文件为 deploy/.env 后填写真实值（.env 已被 .gitignore 忽略，不会进版本库）
#   cp .env.example .env
# ============================================

# ---------- 后端：PostgreSQL（复用服务器已有实例）----------
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/astral?currentSchema=astral
SPRING_DATASOURCE_USERNAME=astral
SPRING_DATASOURCE_PASSWORD=change-me

# ---------- 后端：Redis（复用服务器已有实例）----------
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=7

# ---------- 后端：CORS 跨域白名单 ----------
# 【当前形态：跨域直连，本项必填】
#   管理端页面在 https://web.canace.cn，接口在 https://astral.canace.cn（见 deploy/nginx/），
#   两者子域不同 → 浏览器发的是跨域请求，每个会发请求的前端域名都必须列在这里（逗号分隔）。
#   漏一个，该域名登录就报「无法连接到服务器」（OPTIONS 预检 403 Invalid CORS request）。
#   注意：博客 www.canace.cn 的 /api 由 blog 容器同源处理，不在此列。
#
# 【若将来改成同源形态（管理端也走自己的 /api 反代到后端）】
#   浏览器全程同源，不产生跨域请求，本项保持默认即可。
#
# 2026-09-28 起后端 CORS 默认值从 * 收紧为 http://localhost:3000（allowCredentials=true 下
# 通配等于对任意站点开放带凭据跨域），因此跨域形态必须显式配置本项。
# 注意：此变量必须出现在 docker-compose.yml backend 的 environment: 里才会传进容器
# （compose 只透传 environment 引用到的变量，光写在 .env 里不生效，踩过）。
#
# 生产示例（web 页面 + astral 接口，两个域名同属 canace.cn，Cookie 仍算同站）：
#   CORS_ALLOWED_ORIGINS=https://web.canace.cn
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- 后端：文件存储插件 HMAC 密钥（Cloudflare Worker 通道）----------
# 与 Worker 侧的 3 个 Secret 必须逐字一致，不一致时 Worker 请求被拒（错误码 STORAGE017）。
# 三把密钥必须两两不同；推荐用 openssl rand -base64 48 各生成一次，永不进 Git/聊天/截图。
# 不用文件存储功能时可留空。
STORAGE_UPLOAD_TICKET_KEY=
STORAGE_ORIGIN_SHARED_SECRET=
STORAGE_DOWNLOAD_SIGNING_KEY_V1=

# ---------- 后端：AI 插件密钥加密主密钥（KEK）----------
# 用于加密/解密 AI 提供方的 API Key（ai_provider.encrypted_api_key，AES-256-GCM）。
# 推荐 openssl rand -base64 32 生成一次，之后【永不更换】：换了值，之前保存的所有
# 提供方密文都解不开，后台报「AI 提供方或模型不可用：提供方密钥无法解密，请重新保存」，
# 需要逐个提供方重新保存密钥。此值必须出现在 docker-compose.yml backend 的
# environment: 里才会传进容器（光写在 .env 里不生效）。
ASTRAL_AI_SECRET_KEY=

# ---------- 前端 API 基地址（已废弃，见下）----------
# 2026-10 前端镜像同源化改造后，bundle 固定为同源相对路径 /api，
# 由容器内 proxy.js 按启动时 BACKEND_URL（compose environment）转发到后端。
# 换后端只需改 BACKEND_URL 重启容器，本变量不再参与任何构建/运行链路。
# NEXT_PUBLIC_API_URL=

# ---------- 镜像仓库：仅当服务器改为「只 pull 不 build」时需要 ----------
# 引用 deploy/docker-compose.registry.yml 时使用（./update.sh 已自动引用）。
# REGISTRY 只填到「命名空间」为止，不带仓库名；实际镜像仓库为 astral-backend / astral-frontend / astral-blog。
#   CNB Docker 制品库（当前使用，镜像随代码仓库 canace/astral 托管）：
#     REGISTRY=docker.cnb.cool/canace/astral
#     - CNB 云原生构建自动推送，无需任何凭证配置
#     - 仓库当前为公开：镜像可匿名拉取，服务器无需 docker login
#       （若改回私有仓，需用 CNB 访问令牌登录一次，见 DEPLOY_GUIDE.md）
#   ghcr.io（备选：国内拉取慢且易断，实测首次 pull 15 分钟未完成）：
#     REGISTRY=ghcr.io/<你的GitHub用户名>
REGISTRY=docker.cnb.cool/canace/astral

# TAG 是发布与回滚开关：
#   latest            跟随 CI 最新构建
#   20260926-a1b2c3d  CI 产出的日期 tag（Actions 日志/包页面可查），指定它即为精确发布
#   回滚 = 把 TAG 改成上一个日期 tag，再执行 ./update.sh
TAG=latest
