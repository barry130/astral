# ============================================
# Astral 部署环境变量模板
# 复制本文件为 deploy/.env 后填写真实值（.env 已被 .gitignore 忽略，不会进版本库）
#   cp .env.example .env
# ============================================

# ---------- 后端：PostgreSQL（复用服务器已有实例）----------
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/astral?currentSchema=astral
SPRING_DATASOURCE_USERNAME=astral
SPRING_DATASOURCE_PASSWORD=change-me

# ---------- 后端：Redis（复用服务器已有实例）----------
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=7

# ---------- 后端：CORS 跨域白名单（当前生产为「跨域直连」形态）----------
# 前端部署在 https://web.canace.cn，浏览器直连 https://astral.canace.cn/api/**（跨域），
# 每个会发跨域请求的前端域名都必须列在这里（逗号分隔），漏一个该域名登录就报
# 「无法连接到服务器」（OPTIONS 预检 403 Invalid CORS request）。
# 2026-09-28 起后端 CORS 默认值从 * 收紧为 http://localhost:3000（allowCredentials=true 下
# 通配等于对任意站点开放带凭据跨域），因此生产必须显式配置本项。
# 注意：此变量必须出现在 docker-compose.yml backend 的 environment: 里才会传进容器
# （compose 只透传 environment 引用到的变量，光写在 .env 里不生效，踩过）。
CORS_ALLOWED_ORIGINS=https://web.canace.cn,http://web.canace.cn,https://astral.canace.cn,https://www.astral.canace.cn,http://astral.canace.cn,http://www.astral.canace.cn,http://localhost:3000

# ---------- 后端：文件存储插件 HMAC 密钥（Cloudflare Worker 通道）----------
# 与 Worker 侧的 3 个 Secret 必须逐字一致，不一致时 Worker 请求被拒（错误码 STORAGE017）。
# 三把密钥必须两两不同；推荐用 openssl rand -base64 48 各生成一次，永不进 Git/聊天/截图。
# 不用文件存储功能时可留空。
STORAGE_UPLOAD_TICKET_KEY=
STORAGE_ORIGIN_SHARED_SECRET=
STORAGE_DOWNLOAD_SIGNING_KEY_V1=

# ---------- 前端：浏览器访问 API 的基地址（构建时内联）----------
# 留空（推荐）：走同源相对路径 /api，由 Next.js 服务端 rewrites 转发到 backend 容器，
#               无跨域 / Mixed Content 问题，后端端口无需对公网开放。
# 非空：浏览器直连该地址，必须为 https:// 且后端 CORS_ALLOWED_ORIGINS 包含前端域名。
# 修改后需重建前端镜像：docker compose build --no-cache frontend && docker compose up -d frontend
#
# 【注意】改用 CI 构建镜像后（见 DEPLOY_GUIDE.md「CI 构建 + 服务器 pull 更新」），
# 本文件里的这个值不再影响镜像内容：它只在服务器本地 build 时生效。
# CI 走的是 GitHub 仓库变量 NEXT_PUBLIC_API_URL（Settings → Secrets and variables → Actions → Variables）。
NEXT_PUBLIC_API_URL=

# ---------- 镜像仓库：仅当服务器改为「只 pull 不 build」时需要 ----------
# 引用 deploy/docker-compose.registry.yml 时使用（./update.sh 已自动引用）。
# REGISTRY 只填到「命名空间」为止，不带仓库名；实际镜像仓库为 astral-backend / astral-frontend。
#   腾讯云 TCR 个人版（当前使用）：
#     REGISTRY=ccr.ccs.tencentyun.com/tcb-100008754513-winj
#     - GitHub Actions 用这个公网地址推送
#     - 服务器与 registry 同区时，可换成控制台给出的「内网地址」（更快、免公网流量）
#     - 仓库默认私有：服务器需先 docker login 一次（见 DEPLOY_GUIDE.md）
#   ghcr.io（备选：国内拉取慢且易断，实测首次 pull 15 分钟未完成）：
#     REGISTRY=ghcr.io/<你的GitHub用户名>
REGISTRY=ccr.ccs.tencentyun.com/tcb-100008754513-winj

# TAG 是发布与回滚开关：
#   latest            跟随 CI 最新构建
#   20260926-a1b2c3d  CI 产出的日期 tag（Actions 日志/包页面可查），指定它即为精确发布
#   回滚 = 把 TAG 改成上一个日期 tag，再执行 ./update.sh
TAG=latest
